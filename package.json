{
  "name": "portfolio-datacenter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio de Noah Guglielmino — une page 2D façon salle serveur, et une salle 3D explorable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "html-validate \"dist/**/*.html\" && java -jar node_modules/vnu-jar/build/dist/vnu.jar --skip-non-html --errors-only dist",
    "budget": "node scripts/budget.mjs",
    "a11y": "node scripts/a11y.mjs",
    "shots": "node scripts/shots.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "axe-core": "^4.14.1",
    "html-validate": "^11.21.1",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vnu-jar": "^26.11.20"
  }
}
